#!/bin/bash
# claude-song — plays a song when Claude Code is finished, until you press Space.
#
#   claude-song set <file-or-name>   choose one fixed song: a path, or part of a filename in the songs folder
#   claude-song add <file>           copy a file into the songs folder and select it
#   claude-song shuffle [on|off]     rotate a different song from the songs folder every time
#   claude-song arm                  called by the Stop hook: play once the session goes quiet
#   claude-song play                 play right now, without waiting for quiet
#   claude-song stop                 stop the song and cancel anything pending (run by the UserPromptSubmit hook)
#   claude-song status               show the current song, the settings, and whether it is playing
#   claude-song list                 list the songs folder
#   claude-song log                  show the last few play / skip decisions
#   claude-song off | on             pause / resume the alert without uninstalling
#   claude-song config               print the settings file path
#
# Data lives in ~/.claude/claude-song  (song.conf, songs/, bin/)

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do SELF="$(readlink "$SELF")"; done
BIN="$(cd "$(dirname "$SELF")" && pwd)"

APP="$HOME/.claude/claude-song"
CONF="$APP/song.conf"
SONGS="$APP/songs"
RUN="$APP/.run"
LOG="$APP/.last-dialog.log"
PLAYLOG="$APP/.play-log"
LASTSONG="$APP/.last-song"
SOUNDS=/System/Library/Sounds
MARK="claude-song _player"       # every player/loop process carries this command line
WAITMARK="claude-song _wait"     # every pending quiet-watcher carries this one
TITLE="Claude Code is done"
EXTS_ARGS=(-iname '*.mp3' -o -iname '*.m4a' -o -iname '*.aac' -o -iname '*.wav' -o -iname '*.aiff' -o -iname '*.aif' -o -iname '*.flac' -o -iname '*.caf')

load_conf() {
  SONG="default-jingle"; VOLUME=1; LOOP=0; MAX_MINUTES=0; SHUFFLE=0; QUIET_SECONDS=25; WORK_ONLY=1
  [ -f "$CONF" ] && . "$CONF"
  SONG="${SONG/#\~/$HOME}"
}

save_conf() {
  mkdir -p "$APP"
  cat > "$CONF" <<CONF_EOF
# claude-song settings. Edit freely, or run: claude-song set <file-or-name> / claude-song shuffle on
# SONG can be a full path to an audio file, or just part of a filename
# to look for inside $SONGS (case-insensitive). Ignored while SHUFFLE=1.
SONG="$SONG"
VOLUME=$VOLUME          # 1 = normal, 0.5 = half, 2 = louder
LOOP=$LOOP            # 0 = play the song once and stop on its own, 1 = repeat until you press Space
MAX_MINUTES=$MAX_MINUTES     # safety cap in minutes; 0 = no cap
SHUFFLE=$SHUFFLE          # 1 = pick a different song from the songs folder every time, 0 = always play SONG

# Only play once Claude has been quiet this many seconds, so a long task that
# pauses and carries on does not start a new song each time. 0 = play immediately.
QUIET_SECONDS=$QUIET_SECONDS
# 1 = only play after a turn that actually did something (ran tools), not after
# a plain back-and-forth reply. 0 = play after any turn.
WORK_ONLY=$WORK_ONLY
CONF_EOF
}

logline() { mkdir -p "$APP"; printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "$PLAYLOG"; tail -n 200 "$PLAYLOG" > "$PLAYLOG.tmp" 2>/dev/null && mv -f "$PLAYLOG.tmp" "$PLAYLOG"; }

# All playable files sitting in the songs folder, one per line.
all_songs() {
  find "$SONGS" -maxdepth 1 -type f \( "${EXTS_ARGS[@]}" \) 2>/dev/null | sort
}

# Resolve SONG to an actual file. Prints the path, or nothing if not found.
resolve_song() {
  [ -z "$SONG" ] && return 1
  if [ -f "$SONG" ]; then printf '%s\n' "$SONG"; return 0; fi
  find "$SONGS" -maxdepth 1 -type f -iname "*${SONG}*" \( "${EXTS_ARGS[@]}" \) \
    2>/dev/null | sort | head -n 1 | grep .
}

# Pick the next song for shuffle mode: never the same file two plays in a row
# (unless it's the only one), and remember the pick so the next play differs.
resolve_shuffle_pick() {
  local pool count last pick tries=0
  pool=$(all_songs | grep -v '/default-jingle\.wav$')
  [ -z "$pool" ] && pool=$(all_songs)   # nothing but the bundled jingle: use it
  [ -z "$pool" ] && return 1
  count=$(printf '%s\n' "$pool" | grep -c .)
  last=""; [ -f "$LASTSONG" ] && last=$(cat "$LASTSONG" 2>/dev/null)
  if [ "$count" -le 1 ]; then
    pick=$(printf '%s\n' "$pool" | head -1)
  else
    # $RANDOM reseeds per bash process (this script is re-exec'd fresh each play),
    # unlike awk's srand() which reseeds from the current second and repeats
    # within the same second on rapid back-to-back plays.
    local idx
    while [ $tries -lt 10 ]; do
      idx=$(( (RANDOM * 32768 + RANDOM) % count + 1 ))
      pick=$(printf '%s\n' "$pool" | sed -n "${idx}p")
      [ "$pick" != "$last" ] && break
      tries=$((tries + 1))
    done
  fi
  printf '%s\n' "$pick" > "$LASTSONG"
  printf '%s\n' "$pick"
}

is_playing() { pgrep -f "$MARK" >/dev/null 2>&1; }
is_pending() { pgrep -f "$WAITMARK" >/dev/null 2>&1; }

# Kill the audio + window, race-free. Leaves pending quiet-watchers alone.
kill_players() {
  local pids kids
  pids=$(pgrep -f "$MARK" 2>/dev/null)
  if [ -n "$pids" ]; then
    kill -STOP $pids 2>/dev/null                       # freeze so the loop cannot respawn afplay
    kids=$(for p in $pids; do pgrep -P "$p"; done)
    [ -n "$kids" ] && kill -TERM $kids 2>/dev/null     # afplay + window
    kill -TERM $pids 2>/dev/null; kill -CONT $pids 2>/dev/null
  fi
  rm -rf "$RUN"
}

# Stop everything: the music now, and any song that was waiting to start.
do_stop() {
  local w
  w=$(pgrep -f "$WAITMARK" 2>/dev/null)
  [ -n "$w" ] && kill -TERM $w 2>/dev/null
  kill_players
}

# ---- the Stop hook lands here -------------------------------------------------
# Don't play yet. Wait until Claude has actually stopped working, so a task that
# pauses and carries on doesn't start a new song every time it pauses.
do_arm() {
  [ -e "$APP/off" ] && exit 0
  load_conf
  mkdir -p "$APP"

  local payload transcript
  payload=$(cat 2>/dev/null)
  transcript=$(printf '%s' "$payload" | /usr/bin/python3 -c \
    'import json,sys
try: print(json.load(sys.stdin).get("transcript_path",""))
except Exception: print("")' 2>/dev/null)
  transcript="${transcript/#\~/$HOME}"

  # No quiet period wanted, or no transcript to watch: behave like before.
  if [ "${QUIET_SECONDS:-0}" -le 0 ] 2>/dev/null || [ ! -f "$transcript" ]; then
    do_play
    return
  fi

  # Supersede any watcher already pending for this session.
  local key token
  key=$(basename "$transcript" .jsonl)
  token="$$-$RANDOM"
  echo "$token" > "$APP/.pending-$key"
  perl -e 'use POSIX; POSIX::setsid(); exec @ARGV' -- \
    "$BIN/claude-song" _wait "$transcript" "$key" "$token" </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null
}

# How much real conversation the transcript holds: assistant + user rows only.
# Claude Code also appends bookkeeping rows (including the summary of this very
# hook) after a turn ends, so a plain size/mtime check would always look like
# "still working" and the song would never play.
tsig() {
  /usr/bin/python3 - "$1" <<'PY' 2>/dev/null || echo unknown
import json,sys,os
p=sys.argv[1]
try:
    size=os.path.getsize(p)
    with open(p,'rb') as f:
        if size>400000: f.seek(size-400000)
        data=f.read().decode('utf-8','ignore')
except Exception:
    print("unknown"); sys.exit()
n=0; tools=0
for line in data.split('\n'):
    line=line.strip()
    if not line: continue
    try: r=json.loads(line)
    except Exception: continue
    t=r.get('type')
    if t in ('assistant','user'):
        n+=1
        c=r.get('message',{}).get('content')
        if isinstance(c,list):
            tools+=sum(1 for b in c if isinstance(b,dict) and b.get('type')=='tool_use')
print(f"{n}-{tools}")
PY
}

# Did the turn that just ended actually do something (run tools), or was it
# only a conversational reply? Prints "work" or "talk".
turn_did_work() {
  /usr/bin/python3 - "$1" <<'PY' 2>/dev/null || echo work
import json,sys,os
p=sys.argv[1]
try:
    size=os.path.getsize(p)
    with open(p,'rb') as f:
        if size>400000: f.seek(size-400000)
        rows=[]
        for line in f.read().decode('utf-8','ignore').split('\n'):
            line=line.strip()
            if not line: continue
            try: rows.append(json.loads(line))
            except Exception: pass
except Exception:
    print("work"); sys.exit()

def is_real_user(r):
    if r.get('type')!='user': return False
    c=r.get('message',{}).get('content')
    if isinstance(c,list):
        if any(isinstance(b,dict) and b.get('type')=='tool_result' for b in c): return False
    return True

tools=0
for r in reversed(rows):
    if is_real_user(r): break
    if r.get('type')!='assistant': continue
    msg=r.get('message',{})
    if msg.get('stop_reason')=='tool_use': tools+=1; continue
    c=msg.get('content')
    if isinstance(c,list) and any(isinstance(b,dict) and b.get('type')=='tool_use' for b in c): tools+=1
print("work" if tools else "talk")
PY
}

# The detached watcher: play only if the session really has gone quiet.
do_wait() {
  local transcript="$1" key="$2" token="$3"
  load_conf
  local before after
  before=$(tsig "$transcript")
  sleep "${QUIET_SECONDS:-25}"

  # A newer turn armed its own watcher: that one owns the decision now.
  [ "$(cat "$APP/.pending-$key" 2>/dev/null)" = "$token" ] || exit 0

  after=$(tsig "$transcript")
  if [ "$before" != "$after" ]; then
    logline "skipped — Claude was still working (quiet ${QUIET_SECONDS}s not reached)"
    exit 0
  fi
  if [ "${WORK_ONLY:-0}" = "1" ] && [ "$(turn_did_work "$transcript")" = "talk" ]; then
    logline "skipped — that turn was just a reply, no work done"
    exit 0
  fi
  kill_players
  start_player
}

do_play() {
  [ -e "$APP/off" ] && exit 0
  do_stop
  start_player
}

start_player() {
  mkdir -p "$RUN"
  # Run the player in its own session so it outlives the hook that started it,
  # then wait (up to 3 s) until it confirms it is running before returning.
  perl -e 'use POSIX; POSIX::setsid(); exec @ARGV' -- "$BIN/claude-song" _player </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null
  local i=0
  while [ ! -f "$RUN/player.pid" ] && [ $i -lt 60 ]; do sleep 0.05; i=$((i+1)); done
}

# Build the native Space-key window from source if the Xcode tools are present.
compile_dialog() {
  xcode-select -p >/dev/null 2>&1 || return 1
  command -v swiftc >/dev/null 2>&1 || return 1
  [ -f "$BIN/song-dialog.swift" ] || return 1
  mkdir -p "$APP/bin"
  swiftc -swift-version 5 -suppress-warnings -O -framework AppKit \
    -o "$APP/bin/song-dialog.tmp" "$BIN/song-dialog.swift" >/dev/null 2>&1 \
    && mv -f "$APP/bin/song-dialog.tmp" "$APP/bin/song-dialog"
}

# Show the "done" window and block until it is dismissed.
# Order: locally compiled window -> prebuilt window shipped with the app -> AppleScript dialog (Enter only).
# If $RUN/ended.flag appears (the song finished playing on its own with LOOP=0),
# a killed window counts as a normal close, not a failure — no fallback is tried.
show_window() {
  local msg="$1" secs="$2" d rc
  [ -x "$APP/bin/song-dialog" ] || compile_dialog
  for d in "$APP/bin/song-dialog" "$BIN/song-dialog"; do
    [ -x "$d" ] || continue
    "$d" "$msg" "$TITLE" "$secs" >/dev/null 2>"$LOG" &
    echo $! > "$RUN/dialog.pid"
    wait $!; rc=$?
    [ $rc -eq 0 ] && return 0
    [ -f "$RUN/ended.flag" ] && return 0
  done
  [ -f "$RUN/ended.flag" ] && return 0
  osascript "$BIN/song-dialog.applescript" "$msg" "$TITLE" "$secs" >/dev/null 2>&1
}

do_player() {
  load_conf
  mkdir -p "$RUN"
  echo $$ > "$RUN/player.pid"   # signals start_player that we are detached and running
  local file msg
  if [ "$SHUFFLE" = "1" ]; then file=$(resolve_shuffle_pick); else file=$(resolve_song); fi
  if [ -n "$file" ]; then
    logline "played — $(basename "$file")"
    (
      while :; do
        afplay -v "$VOLUME" "$file" & wait $!
        [ "$LOOP" = "1" ] || break
      done
      if [ "$LOOP" != "1" ]; then
        # played once all the way through and LOOP is off: close the window too,
        # instead of leaving it open and silent until someone dismisses it.
        touch "$RUN/ended.flag"
        local dpid; [ -f "$RUN/dialog.pid" ] && dpid=$(cat "$RUN/dialog.pid" 2>/dev/null)
        [ -n "$dpid" ] && kill "$dpid" 2>/dev/null
      fi
    ) &
    if [ "$SHUFFLE" = "1" ]; then
      msg="Now playing: $(basename "$file")
(shuffling — a different song plays next time)

Press Space or Enter to stop the music."
    else
      msg="Now playing: $(basename "$file")

Press Space or Enter to stop the music."
    fi
    [ "$LOOP" != "1" ] && msg="$msg
Plays once, then stops on its own."
  else
    logline "played — no song file found, chime instead"
    ( afplay "$SOUNDS/Glass.aiff"; afplay "$SOUNDS/Hero.aiff" ) &
    msg="No song file found for: ${SONG:-<none set>}

Run:  claude-song add <your-song.mp3>"
  fi
  local secs=31536000
  [ "${MAX_MINUTES:-0}" -gt 0 ] 2>/dev/null && secs=$((MAX_MINUTES * 60))
  show_window "$msg" "$secs"
  kill_players   # window dismissed (Space / Enter / Esc / click / timeout): stop everything
}

do_set() {
  local arg="$1"
  [ -z "$arg" ] && { echo "usage: claude-song set <audio file, or part of a filename in $SONGS>"; exit 1; }
  load_conf
  arg="${arg/#\~/$HOME}"
  if [ -f "$arg" ]; then
    arg="$(cd "$(dirname "$arg")" && pwd)/$(basename "$arg")"
    afinfo "$arg" >/dev/null 2>&1 || { echo "macOS cannot play this file: $arg"; exit 1; }
    SONG="$arg"
  else
    SONG="$arg"
    resolve_song >/dev/null || echo "note: nothing in $SONGS matches \"$arg\" yet. Add a file there and it will be picked up."
  fi
  SHUFFLE=0
  save_conf
  echo "Song set to: $SONG"
  local f; f=$(resolve_song) && echo "Resolves to: $f"
}

do_add() {
  local f="${1/#\~/$HOME}"
  [ -f "$f" ] || { echo "usage: claude-song add <audio file>"; exit 1; }
  afinfo "$f" >/dev/null 2>&1 || { echo "macOS cannot play this file: $f"; exit 1; }
  mkdir -p "$SONGS"
  cp "$f" "$SONGS/"
  load_conf
  if [ "$SHUFFLE" = "1" ]; then
    echo "Added to the shuffle folder: $(basename "$f")"
    local n; n=$(all_songs | grep -v '/default-jingle\.wav$' | grep -c .)
    echo "Now rotating through $n song(s). Add more any time, or 'claude-song shuffle off' to pin one."
  else
    do_set "$SONGS/$(basename "$f")"
  fi
}

do_shuffle() {
  load_conf
  case "$1" in
    ""|status) ;;
    on)  SHUFFLE=1; save_conf; rm -f "$LASTSONG" ;;
    off) SHUFFLE=0; save_conf ;;
    *)   echo "usage: claude-song shuffle [on|off]"; exit 1 ;;
  esac
  load_conf
  local n; n=$(all_songs | grep -v '/default-jingle\.wav$' | grep -c .)
  if [ "$SHUFFLE" = "1" ]; then
    echo "Shuffle is ON — a different song from $SONGS plays every time ($n in rotation)."
    [ "$n" -eq 0 ] && echo "Nothing there yet: claude-song add <song.mp3>  (repeat for each song)"
  else
    echo "Shuffle is OFF — always plays: $SONG"
    echo "Turn it on with: claude-song shuffle on"
  fi
}

do_status() {
  load_conf
  if [ "$SHUFFLE" = "1" ]; then
    local n last; n=$(all_songs | grep -v '/default-jingle\.wav$' | grep -c .)
    echo "Setting : SHUFFLE ON — rotating $n song(s) in $SONGS"
    [ -f "$LASTSONG" ] && { last=$(cat "$LASTSONG"); echo "Last    : $(basename "$last")"; }
  else
    echo "Setting : SONG=\"$SONG\""
    local f; f=$(resolve_song) && echo "File    : $f" || echo "File    : NOT FOUND (will play a short chime instead)"
  fi
  if [ "$LOOP" = "1" ]; then
    echo "Length  : repeats until you press Space"
  else
    echo "Length  : plays once, then stops on its own"
  fi
  if [ "${QUIET_SECONDS:-0}" -gt 0 ] 2>/dev/null; then
    echo "Waits   : plays only after Claude has been quiet ${QUIET_SECONDS}s$([ "${WORK_ONLY:-0}" = "1" ] && echo ", and only after a turn that ran tools")"
  else
    echo "Waits   : no — plays the moment a turn ends"
  fi
  echo "          VOLUME=$VOLUME  MAX_MINUTES=$MAX_MINUTES"
  if [ -x "$APP/bin/song-dialog" ] || [ -x "$BIN/song-dialog" ]; then echo "Window  : native (Space / Enter / Esc stop it)"; else echo "Window  : AppleScript fallback (Enter stops it)"; fi
  [ -e "$APP/off" ] && echo "Alert   : OFF (run 'claude-song on' to enable)"
  if is_playing; then echo "Playing : yes (press Space on the window, or run 'claude-song stop')"
  elif is_pending; then echo "Playing : not yet — waiting for Claude to go quiet"
  else echo "Playing : no"; fi
}

do_list() {
  load_conf
  echo "Songs in $SONGS:"
  all_songs | while read -r f; do
    [ "$SHUFFLE" = "1" ] && [ "$(basename "$f")" = "default-jingle.wav" ] && [ "$(all_songs | grep -vc '/default-jingle\.wav$')" -gt 0 ] && continue
    printf '  %s\n' "$(basename "$f")"
  done
}

case "$1" in
  arm)        do_arm ;;
  play|test)  do_play ;;
  _player)    do_player ;;
  _wait)      do_wait "$2" "$3" "$4" ;;
  stop)       do_stop ;;
  set)        do_set "$2" ;;
  add)        do_add "$2" ;;
  shuffle)    do_shuffle "$2" ;;
  status)     do_status ;;
  list)       do_list ;;
  log)        tail -n "${2:-15}" "$PLAYLOG" 2>/dev/null || echo "nothing played yet" ;;
  off)        mkdir -p "$APP"; touch "$APP/off"; do_stop; echo "claude-song is OFF. Run 'claude-song on' to enable." ;;
  on)         rm -f "$APP/off"; echo "claude-song is ON." ;;
  config)     echo "$CONF" ;;
  *)          sed -n '2,17p' "$0"; exit 1 ;;
esac
